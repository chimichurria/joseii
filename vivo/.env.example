# Variables del servidor en vivo. En Vercel se cargan en Settings → Environment Variables.
# Nunca subas un archivo .env con valores reales al repositorio.

# PIN del presentador, de 4 a 8 dígitos. Elegí uno propio.
REMOTE_PIN=

# La agrega sola la integración de Neon (Storage → Create Database → Neon).
DATABASE_URL=

# Opcional. Si no la ponés, se deriva de DATABASE_URL y el PIN.
TOKEN_SECRET=
